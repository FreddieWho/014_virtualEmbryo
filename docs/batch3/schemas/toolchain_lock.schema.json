{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolchain Lock",
  "type": "object",
  "required": [
    "created_at",
    "environments",
    "tools"
  ],
  "properties": {
    "created_at": {
      "type": "string"
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "smoke_test": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
