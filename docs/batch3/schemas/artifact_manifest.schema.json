{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Manifest",
  "type": "object",
  "required": [
    "task_id",
    "created_at",
    "repo_commit",
    "files"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "repo_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
