{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T3 Signed Prior",
  "type": "object",
  "required": [
    "schema_version",
    "condition_ids",
    "lane",
    "sign_definition",
    "records",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ve.t3.signed-prior.v2"
    },
    "condition_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lane": {
      "enum": [
        "L1_STRICT_AGREEMENT",
        "L2_CONDITION_AWARE"
      ]
    },
    "sign_definition": {
      "const": "KO_MINUS_MATCHED_WT"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_gene",
          "condition_id",
          "stage",
          "state",
          "response_gene",
          "sign",
          "rank_score",
          "confidence",
          "lineage_gate",
          "dosage_fraction",
          "source_families",
          "conflict_flag",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "target_gene": {
            "type": "string",
            "minLength": 1
          },
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "response_gene": {
            "type": "string",
            "minLength": 1
          },
          "sign": {
            "type": "integer",
            "enum": [
              -1,
              0,
              1
            ]
          },
          "rank_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "lineage_gate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "directness_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "dosage_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_families": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "conflict_flag": {
            "type": "boolean"
          },
          "provenance": {
            "type": [
              "array",
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["conflict_flag"],
              "properties": {
                "conflict_flag": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "sign": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
